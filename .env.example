# Kural System Configuration

# =====================================================================
# SUPABASE POSTGRESQL CONNECTION STRING
# =====================================================================
# Replace with your Supabase Database URI (Settings -> Database -> Connection string -> Transaction / Direct Pooler):
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# OpenAI API Key (optional - system falls back to mock classifier if blank)
OPENAI_API_KEY=

# Twilio Credentials (optional for mock dev)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_VOICE_NUMBER=

# Frontend & Map configuration
MAPBOX_TOKEN=
PUBLIC_BASE_URL=http://localhost:8000
